# Copy to .env and fill in values: cp .env.example .env

# Azure OpenAI (required)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key
OPENAI_API_KEY=your_azure_openai_key
OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_MODEL=gpt-4o-mini
AZURE_OPENAI_EMEBDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_API_EMEBDDING_VERSION=2024-02-01

# Web search (required)
TAVILY_API_KEY=your_tavily_key

# HTTP Basic Auth for the API; also used by the Streamlit frontend (required)
API_USERNAME=choose_a_username
API_PASSWORD=choose_a_password

# Email / OTP
# Comma-separated emails allowed to verify via OTP
ALLOWED_EMAILS=you@example.com
SMTP_FROM=noreply@example.com
SMTP_SERVER=your_smtp_host
SMTP_PORT=25
# Optional: if set, STARTTLS + login are used
SMTP_USER=
SMTP_PWD=

# Optional
CHECKPOINT_DB=checkpoints.sqlite
CORS_ORIGINS=*
# Frontend only; docker-compose sets this to http://backend:8000
API_URL=http://127.0.0.1:8000
